{
  "name": "iceratops-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "test": "node --test scripts/*.test.mjs",
    "lint": "biome check . && pnpm run lint:copy && pnpm run validate:translations",
    "lint:copy": "node scripts/check-em-dashes.mjs",
    "validate:site": "node scripts/check-site.mjs",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "validate:translations": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2"
  }
}
